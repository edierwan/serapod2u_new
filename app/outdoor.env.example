# Serapod Outdoor / EasyParcel (server-only — never NEXT_PUBLIC_*)
# Copy values into app/.env.local or hosting secrets.

EASYPARCEL_API_KEY=
# Live: https://connect.easyparcel.my/?ac=
# Demo: https://demo.connect.easyparcel.my/?ac=
EASYPARCEL_API_BASE=https://demo.connect.easyparcel.my/?ac=

EASYPARCEL_PICK_CODE=
EASYPARCEL_PICK_STATE=selangor
EASYPARCEL_PICK_COUNTRY=MY
EASYPARCEL_PICK_NAME=Serapod Outdoor
EASYPARCEL_PICK_COMPANY=Serapod
EASYPARCEL_PICK_CONTACT=
EASYPARCEL_PICK_MOBILE=
EASYPARCEL_PICK_ADDR1=
EASYPARCEL_PICK_CITY=
EASYPARCEL_DEFAULT_WEIGHT=1

# Optional: restrict Outdoor shop to one brand UUID (leave empty = shared catalogue)
OUTDOOR_BRAND_ID=

# Prefer locking Outdoor shop to a category UUID (recommended)
# If both empty, auto-detect categories/brands whose name contains "Outdoor"
OUTDOOR_CATEGORY_ID=

# Optional analytics / SEO
NEXT_PUBLIC_OUTDOOR_SITE_URL=https://outdoor.serapod.com
NEXT_PUBLIC_OUTDOOR_GA_ID=
NEXT_PUBLIC_OUTDOOR_GSC_VERIFICATION=

# Optional social (shown in Outdoor footer when set)
NEXT_PUBLIC_OUTDOOR_INSTAGRAM=
NEXT_PUBLIC_OUTDOOR_FACEBOOK=
NEXT_PUBLIC_OUTDOOR_TIKTOK=
